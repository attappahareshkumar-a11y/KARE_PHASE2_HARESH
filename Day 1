1//Finding Even or Odd Number
-------------------------------
import java.util.*;
class Main {
    public static void main (String [] args) {
        Scanner obj = new Scanner(System.in);
        int a = obj.nextInt();
       
        if(a%2==0)
        System.out.println( a +"Even Number");
        else
        System.out.println( a +"odd Number");
    }
    
}


